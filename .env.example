# Copy to .env for local dev. In production set these as Coolify environment variables.

# Postgres connection string. Coolify fills this in from the database resource.
DATABASE_URL=postgres://9r2:9r2@127.0.0.1:5433/9r2

# Long random string. Encrypts S3 credentials and share tokens at rest.
SESSION_SECRET=replace-me-with-a-long-random-string

# The single account. Its row is created on the first sign-in.
ADMIN_EMAIL=admin@9r2.local
ADMIN_PASSWORD=change-me-local-dev

# Port the Bun server listens on.
PORT=3000

# Optional: JSON array of S3-compatible accounts seeded for a new account, so a fresh
# install has storage without adding an account by hand.
# SEED_BUCKETS=[{"name":"Primary","endpoint":"https://<account-id>.r2.cloudflarestorage.com","region":"auto","bucketName":"9r2-primary","accessKeyId":"...","secretAccessKey":"...","quotaBytes":null}]
