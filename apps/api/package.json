{
  "name": "@9r2/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply 9r2-db --local && wrangler dev --port ${API_PORT:-8788}",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply 9r2-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply 9r2-db --remote"
  },
  "dependencies": {
    "@9r2/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
