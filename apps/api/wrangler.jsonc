{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "9r2",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/public/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "9r2-db",
      "database_id": "a516940d-267e-4916-83f4-7cbd2f0c22c7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_PRIMARY",
      "bucket_name": "9r2-primary"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "BUCKET_CONFIG": "[{\"binding\":\"R2_PRIMARY\",\"name\":\"Primary bucket\",\"quotaBytes\":10737418240}]",
    "MAX_UPLOAD_BYTES": "104857600"
  }
}
