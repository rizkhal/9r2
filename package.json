{
  "name": "9r2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "cd apps/web && vite build && cd ../.. && tsc -p apps/api",
    "typecheck": "tsc -p packages/shared && tsc -p apps/api && tsc -p apps/web && tsc -p apps/cf-bootstrap",
    "start": "bun apps/api/src/server.ts",
    "migrate": "bun apps/api/src/migrate.ts",
    "cf-bootstrap": "bun apps/cf-bootstrap/src/index.ts",
    "cf-dashboard": "node apps/cf-dashboard/src/index.mjs",
    "seed:9r2": "node scripts/seed-9r2.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "db:generate": "cd apps/api && drizzle-kit generate",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
